# Deployer key: the BURNER wallet private key (it signs the deploy).
# NEVER commit a real key. Copy this file to .env and fill it in locally.
# .env is gitignored. The Circle agent wallet has no exportable key —
# it never signs; it only receives its allocation.
PRIVATE_KEY=0x...

# Chain to deploy to:
#   5042002  Arc Testnet (default, primary — burner 80 USDC gas)
#   11155111 Sepolia (burner 0.05 ETH — usable now)
#   46630    Robinhood Chain testnet (burner 0.01 ETH)
#   84532    Base Sepolia (NOT deployable — both wallets 0 ETH, no gas)
CHAIN_ID=5042002

# RPC endpoints (public defaults; also in config/token-config.json)
ARC_TESTNET_RPC_URL=https://arc-testnet-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Optional: for `forge verify-contract`
ETHERSCAN_API_KEY=
