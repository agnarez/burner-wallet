# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# Testnet only. Nothing here should ever point at mainnet.

# Burner wallet private key (deployer + minter). We hold this key.
# 0x-prefixed hex. Leave empty to run tests/compile only.
BURNER_PRIVATE_KEY=

# Circle agent wallet, testnet (holder/recipient only).
# It is MPC-held by Circle — no exportable key exists — so it can never sign.
# The deployer mints names TO it with mintTo.
AGENT_WALLET_ADDRESS=0xd305dc7b4f3c4dc0cf1da53bf20cd96ad1653cf7

# Optional: name to mint to the deployer on deploy (e.g. agnarez.arc)
NAME=
# Optional: name to mint to the agent wallet on deploy
AGENT_NAME=

# Already-deployed NameSBT contract (for scripts/mint.js)
NAME_SBT_ADDRESS=

# Optional RPC overrides (defaults are public nodes)
ARC_TESTNET_RPC_URL=https://arc-testnet-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
# Robinhood Chain testnet has no known public RPC — set one here to enable it.
# The burner holds 0.01 testnet ETH there; the agent wallet does not exist on it.
ROBINHOOD_TESTNET_RPC_URL=
