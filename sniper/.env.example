# Sniper tool config — copy to .env and fill in. NEVER commit .env.
# The tool runs in DRY-RUN mode unless DRY_RUN=false. In dry-run it only
# logs what it WOULD do and sends no transaction.

# Chain to watch (default: arc-testnet — the primary chain, it holds gas)
# arc-testnet | robinhood-testnet | sepolia | base-sepolia | litvm-testnet
CHAIN=arc-testnet

# Public RPC override (optional — defaults are built in per chain)
# RPC_URL=https://arc-testnet-rpc.publicnode.com

# --- Wallets (two roles) ---
# Burner wallet = the OPERATOR. We hold its key, so it signs trades.
# Its private key comes ONLY from PRIVATE_KEY below. Leave empty for dry-run.
BURNER_WALLET_ADDRESS=0x6F311641923246e7f4fE2F1F679c75f4DE107621
PRIVATE_KEY=
# Circle agent wallet = the HOLDER / profit recipient. MPC-held by Circle:
# there is NO exportable private key. It can only move USDC via the Circle
# CLI (`circle wallet ...`). Sell proceeds go here by default.
AGENT_WALLET_ADDRESS=0xd305dc7b4f3c4dc0cf1da53bf20cd96ad1653cf7
# Where sell proceeds go (default: the agent wallet). Set to the burner
# address to keep proceeds in the trading wallet instead.
# PROFIT_RECIPIENT=0xd305dc7b4f3c4dc0cf1da53bf20cd96ad1653cf7

# Dry run: "true" (default) = log only, send nothing. Set to "false" to
# actually trade. Live trading also requires a PRIVATE_KEY.
DRY_RUN=true

# Buy size per snipe, in the chain's native token
# (USDC on Arc Testnet, ETH on the other testnets)
BUY_AMOUNT_NATIVE=0.01

# Max slippage, in basis points (500 = 5%)
SLIPPAGE_BPS=500

# Never pay more than this gas price (gwei). Above it, the buy is skipped.
MAX_GAS_GWEI=100

# Exit rules (any one triggers a sell)
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=20
MAX_HOLD_SECONDS=3600

# Only snipe pairs that launch with at least this much base-token liquidity
MIN_BASE_LIQUIDITY=0.1

# DEX overrides (only needed to point at a deployment other than the
# built-in one). Arc Testnet, Robinhood Chain testnet, LitVM testnet and
# Sepolia already default to our AGNAmuse V2 / Uniswap V2 deployments
# (see src/config.js); Base Sepolia has no known deployment.
# FACTORY_ADDRESS=
# ROUTER_ADDRESS=
# BASE_TOKEN_ADDRESS=
